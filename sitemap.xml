{%- comment -%}
Every page a search engine should know: the site's own pages, each food
and each never-food. Left out: a page marked noindex or sitemap: false,
the not-found page, and the endpoints (JSON, calendar feeds, the
standalone wheels), which are not pages. robots.txt points here.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- if p.noindex or p.sitemap == false or p.url == "/404.html" -%}{%- continue -%}{%- endif -%}
  {%- unless p.url contains ".json" or p.url contains ".ics" or p.url contains ".xml" or p.url contains ".txt" %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
  {%- endunless -%}
{%- endfor -%}
{%- for f in site.foods %}
  <url><loc>{{ f.url | absolute_url }}</loc></url>
{%- endfor -%}
{%- for n in site.never %}
  <url><loc>{{ n.url | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
