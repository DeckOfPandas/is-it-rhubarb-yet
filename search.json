---
layout: null
permalink: /search.json
---
{%- comment -%}
What the header's search box matches against: every food and never-food
with its name, the names its varieties are said by, its aliases, and the
baked verdict for the build day.
{%- endcomment -%}
{%- assign baked = site.data.baked -%}
[
{%- for food in site.data.foods -%}
  {%- assign b = baked.foods[food.slug] -%}
  {%- assign terms = "" | split: "" | push: food.name -%}
  {%- for v in food.varieties -%}
    {%- if v.name != "" -%}
      {%- assign lower = food.name | downcase -%}
      {%- assign said = v.name | append: " " | append: lower -%}
      {%- if v.said -%}{%- assign said = v.said -%}{%- endif -%}
      {%- assign terms = terms | push: said -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for a in food.aliases -%}{%- assign terms = terms | push: a -%}{%- endfor -%}
  {"slug": {{ food.slug | jsonify }}, "name": {{ food.name | jsonify }}, "colour": {{ food.colour | jsonify }}, "verdict": {{ b.verdict | jsonify }}, "terms": {{ terms | jsonify }}},
{%- endfor -%}
{%- for n in site.data.never -%}
  {%- assign terms = "" | split: "" | push: n.name -%}
  {%- for a in n.aliases -%}{%- assign terms = terms | push: a -%}{%- endfor -%}
  {"slug": {{ n.slug | jsonify }}, "name": {{ n.name | jsonify }}, "colour": null, "verdict": "NEVER", "never": true, "terms": {{ terms | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
